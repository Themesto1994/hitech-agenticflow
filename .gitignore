# Node
node_modules/
npm-debug.log*

# kane-cli runtime output (generated by pipeline — not source files)
.testmuai/evidence/       # evidence packs (can be large binaries)
.testmuai/sessions/       # local session state
*.evidence                # any stray evidence pack files

# kane-cli context store (generated by `context ingest` — pipeline artifact)
# NOTE: If you want to commit the context store so it persists between runs,
# remove the line below. Otherwise it stays out of the repo.
.context/

# Pipeline temp files
testrun_output.ndjson
authoring_links.tsv
selected_tests.txt
coverage_output.txt
validation_log.txt
maintain_output.txt

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.swp
